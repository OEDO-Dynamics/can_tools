#!/bin/bash

# tests/fakes/ip - Fake 'ip' command for testing
# Logs all calls and responds based on sysfs state

fake_dir="${CAN_TOOLS_FAKE_DIR:-.}"
calls_log="$fake_dir/calls.log"

# Log the call
echo "$@" >> "$calls_log" 2>/dev/null || true

# Check if we should fail or hang
if [[ -f "$fake_dir/fail/ip" ]]; then
    exit 1
fi

if [[ -f "$fake_dir/hang/ip" ]]; then
    # Hang indefinitely
    while true; do
        sleep 1
    done
fi

# Parse arguments
case "$1" in
    -d)
        # "ip -d link show type can" - return iface state
        if [[ "$2" == "link" && "$3" == "show" && "$4" == "type" && "$5" == "can" ]]; then
            # Output all CAN interfaces
            for iface_dir in "$fake_dir"/*/; do
                [[ -d "$iface_dir" ]] || continue
                iface=$(basename "$iface_dir")

                # Check if this looks like an iface dir (has state or config)
                if [[ -f "$iface_dir/state" || -f "$iface_dir/config" ]]; then
                    state_file="$iface_dir/state"
                    config_file="$iface_dir/config"

                    # Determine admin status
                    admin="down"
                    if [[ -f "$config_file" ]] && grep -q "admin=up" "$config_file" 2>/dev/null; then
                        admin="up"
                    fi

                    # First line: iface header with UP or similar
                    flags="<NOARP"
                    [[ "$admin" == "up" ]] && flags="$flags,UP"
                    flags="$flags>"
                    echo "1: $iface: $flags mtu 72"

                    # Second line: CAN state line
                    state=$(cat "$state_file" 2>/dev/null || echo "ERROR-ACTIVE")

                    # Build ctrlmode from config
                    ctrlmode="<"
                    [[ -f "$config_file" ]] && grep -q "berr=on" "$config_file" 2>/dev/null && ctrlmode="$ctrlmode""BERR-REPORTING,"
                    [[ -f "$config_file" ]] && grep -q "fd=on" "$config_file" 2>/dev/null && ctrlmode="$ctrlmode""FD,"
                    ctrlmode="$ctrlmode""TDC-AUTO>"

                    restart_ms=100
                    if [[ -f "$config_file" ]]; then
                        line=$(grep "restart_ms=" "$config_file" 2>/dev/null | head -1)
                        [[ -n "$line" ]] && restart_ms="${line#*=}"
                    fi

                    echo "    can $ctrlmode state $state (berr-counter tx 0 rx 0) restart-ms $restart_ms"
                fi
            done
        fi
        exit 0
        ;;

    "link")
        # "ip link show <if>" or "ip link set ..." variants
        case "$2" in
            show)
                # Check if iface exists
                if [[ -n "$3" ]]; then
                    if [[ -d "$fake_dir/$3" ]]; then
                        echo "1: $3: <NOARP> mtu 72"
                        exit 0
                    else
                        exit 1
                    fi
                fi
                ;;
            set)
                # "ip link set <if> ..." - various operations
                local if="$3"
                local op="$4"

                if [[ ! -d "$fake_dir/$if" ]]; then
                    exit 1
                fi

                case "$op" in
                    "down")
                        # Update config: admin=down
                        mkdir -p "$fake_dir/$if"
                        if [[ -f "$fake_dir/$if/config" ]]; then
                            sed -i 's/admin=.*/admin=down/' "$fake_dir/$if/config" 2>/dev/null || \
                            echo "admin=down" >> "$fake_dir/$if/config"
                        else
                            echo "admin=down" > "$fake_dir/$if/config"
                        fi
                        exit 0
                        ;;
                    "up")
                        # Update config: admin=up, and process type can parameters
                        mkdir -p "$fake_dir/$if"

                        # Parse parameters: type can bitrate ... restart-ms ... berr-reporting ... fd ...
                        shift 4  # Skip "link set <if> up"

                        local bitrate restart_ms berr fd
                        while [[ $# -gt 0 ]]; do
                            case "$1" in
                                type) shift; shift;;  # skip "can"
                                bitrate) shift; shift;;
                                restart-ms)
                                    restart_ms="$2"
                                    shift 2
                                    ;;
                                berr-reporting)
                                    shift
                                    if [[ "$1" == "on" ]]; then
                                        berr="on"
                                    else
                                        berr="off"
                                    fi
                                    shift
                                    ;;
                                dbitrate)
                                    shift 2
                                    ;;
                                fd)
                                    shift
                                    if [[ "$1" == "on" ]]; then
                                        fd="on"
                                    else
                                        fd="off"
                                    fi
                                    shift
                                    ;;
                                *)
                                    shift
                                    ;;
                            esac
                        done

                        # Write config
                        {
                            echo "admin=up"
                            [[ -n "$restart_ms" ]] && echo "restart_ms=$restart_ms" || echo "restart_ms=100"
                            [[ -n "$berr" ]] && echo "berr=$berr" || echo "berr=off"
                            [[ -n "$fd" ]] && echo "fd=$fd" || echo "fd=on"
                        } > "$fake_dir/$if/config"

                        exit 0
                        ;;
                    "name")
                        # "ip link set <if> name <newname>"
                        local newname="$5"
                        if [[ -n "$newname" && "$if" != "$newname" ]]; then
                            # Check if newname already in use (exists as dir)
                            if [[ -d "$fake_dir/$newname" ]]; then
                                exit 1  # Name in use
                            fi
                            # Rename
                            mv "$fake_dir/$if" "$fake_dir/$newname" 2>/dev/null || exit 1
                        fi
                        exit 0
                        ;;
                    "txqueuelen")
                        # "ip link set <if> txqueuelen <val>"
                        # Just acknowledge it
                        exit 0
                        ;;
                    *)
                        exit 1
                        ;;
                esac
                ;;
        esac
        ;;

    *)
        exit 1
        ;;
esac

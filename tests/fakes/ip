#!/bin/bash

# tests/fakes/ip - Fake 'ip' command for testing

fake_dir="${CAN_TOOLS_FAKE_DIR:-.}"
calls_log="$fake_dir/calls.log"

# Log the call
echo "$@" >>"$calls_log" 2>/dev/null || true

# Check if we should fail or hang
[[ -f "$fake_dir/fail/ip" ]] && exit 1
[[ -f "$fake_dir/hang/ip" ]] && { while true; do sleep 1; done; }

# Parse arguments
case "$1" in
    -d)
        if [[ "$2" == "link" && "$3" == "show" && "$4" == "type" && "$5" == "can" ]]; then
            for iface_dir in "$fake_dir"/*/; do
                [[ -d "$iface_dir" ]] || continue
                iface=$(basename "$iface_dir")
                [[ -f "$iface_dir/state" || -f "$iface_dir/config" ]] || continue

                # N-M3: Support both 1-line and 4-line config formats
                admin="down"
                berr="off"
                fd="off"
                restart_ms="100"

                if [[ -f "$iface_dir/config" ]]; then
                    # Read config: can be 1-line format or multi-line format
                    admin=$(grep -o "admin=[a-z]*" "$iface_dir/config" 2>/dev/null | cut -d= -f2 || echo "down")
                    berr=$(grep -o "berr=[a-z]*" "$iface_dir/config" 2>/dev/null | cut -d= -f2 || echo "off")
                    fd=$(grep -o "fd=[a-z]*" "$iface_dir/config" 2>/dev/null | cut -d= -f2 || echo "off")
                    restart_ms=$(grep -o "restart_ms=[0-9]*" "$iface_dir/config" 2>/dev/null | cut -d= -f2 || echo "100")
                fi

                flags="<NOARP"
                [[ "$admin" == "up" ]] && flags="$flags,UP,LOWER_UP,ECHO"
                flags="$flags> mtu 72 qdisc pfifo_fast state UP mode DEFAULT group default qlen 10"

                index=$(($(basename "$iface" | sed 's/[^0-9]//g') + 2))
                echo "$index: $iface: $flags"

                state=$(cat "$iface_dir/state" 2>/dev/null || echo "ERROR-ACTIVE")

                ctrlmode="<"
                [[ "$berr" == "on" ]] && ctrlmode="$ctrlmode""BERR-REPORTING,"
                [[ "$fd" == "on" ]] && ctrlmode="$ctrlmode""FD,"
                ctrlmode="$ctrlmode""TDC-AUTO>"

                echo "    can $ctrlmode state $state (berr-counter tx 0 rx 0) restart-ms $restart_ms"
            done
        fi
        exit 0
        ;;
    "link")
        case "$2" in
            "show")
                # N-M3: Check for state file or config file to indicate iface exists
                if [[ -n "$3" && ( -d "$fake_dir/$3" || -f "$fake_dir/$3/state" || -f "$fake_dir/$3/config" ) ]]; then
                    echo "1: $3: <NOARP> mtu 72"
                    exit 0
                fi
                exit 1
                ;;
            "set")
                if_name="$3"
                op="$4"
                [[ -d "$fake_dir/$if_name" ]] || exit 1

                case "$op" in
                    "down")
                        mkdir -p "$fake_dir/$if_name"
                        sed -i 's/^admin=.*/admin=down/' "$fake_dir/$if_name/config" 2>/dev/null || echo "admin=down" >"$fake_dir/$if_name/config"
                        exit 0
                        ;;
                    "up")
                        mkdir -p "$fake_dir/$if_name"
                        shift 4
                        restart_ms="" berr="off" fd="off"
                        while [[ $# -gt 0 ]]; do
                            case "$1" in
                                type) shift 2;;
                                bitrate|dbitrate) shift 2;;
                                restart-ms) restart_ms="$2"; shift 2;;
                                berr-reporting) berr="$2"; shift 2;;
                                fd) fd="$2"; shift 2;;
                                *) shift;;
                            esac
                        done
                        # N-M3: Write 1-line format config
                        echo "restart_ms=${restart_ms:-100} berr=$berr fd=$fd admin=up" >"$fake_dir/$if_name/config"
                        exit 0
                        ;;
                    "name")
                        newname="$5"
                        [[ -n "$newname" && "$if_name" != "$newname" ]] && { [[ -d "$fake_dir/$newname" ]] && exit 1; mv "$fake_dir/$if_name" "$fake_dir/$newname" 2>/dev/null || exit 1; }
                        exit 0
                        ;;
                    "txqueuelen")
                        exit 0
                        ;;
                esac
                ;;
        esac
        ;;
esac
exit 1
